ROM_SIZE			equ REG_VLM5030_CONTROL
ROM_START			equ $c000

SPRITE_RAM			equ $1000
SPRITE_RAM_SIZE			equ $bf

TILE_RAM			equ $0800
TILE_RAM_SIZE			equ $0800
TILE_RAM_ATTR			equ $0000
TILE_RAM_ATTR_SIZE		equ $0800

; scroll ram seems to be $40 in size, but
; only the first $20 can be read
SCROLL_RAM			equ $2000
SCROLL_RAM_SIZE			equ $20
SCROLL_RAM_ADDRESS_LINES	equ 5

WORK_RAM			equ $1c00
WORK_RAM_SIZE			equ $400

WORK_RAM_CHIP			equ $0000
WORK_RAM_CHIP_SIZE		equ $2000
WORK_RAM_CHIP_ADDRESS_LINES	equ 13

REG_CONTROL			equ $2044
REG_WATCHDOG			equ $3300

REG_SN76489A_DATA		equ $3100
REG_SN76489A_TRIGGER_LOAD	equ $3200

REG_VLM5030_CONTROL		equ $4000
REG_VLM5030_DATA		equ $5000
REG_VLM5030_STATUS		equ $6000

CTRL_NMI_DISABLE		equ $0
CTRL_NMI_ENABLE			equ $1
CTRL_IRQ_DISABLE		equ $0
CTRL_IRQ_ENABLE			equ $2
CTRL_FIRQ_DISABLE		equ $0
CTRL_FIRQ_ENABLE		equ $4

REG_INPUT_P1			equ $3301
REG_INPUT_P2			equ $3302
REG_INPUT_DSW1			equ $3303
REG_INPUT_DSW2			equ $3100
REG_INPUT_DSW3			equ $3200
REG_INPUT_SYS			equ $3300

CHAR_COLON			equ $2b

	macro	WATCHDOG
		sta	REG_WATCHDOG
	endm

	macro	SOUND_PLAY
		sta	REG_VLM5030_DATA
		lda	#$1
		sta	REG_VLM5030_CONTROL
		lda	#$3
		sta	REG_VLM5030_CONTROL

	.\@:
		lda	#$1
		anda	REG_VLM5030_STATUS
		beq	.\@

		lda	#$1
		sta	REG_VLM5030_CONTROL
		clra
		sta	REG_VLM5030_CONTROL
	endm

	macro	SOUND_STOP
	endm
